{
  "name": "peco-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && tsc --noEmit && npm run lint",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "check:launch": "node scripts/check-launch.mjs",
    "test:e2e": "playwright test",
    "visual": "node scripts/visual-compare.mjs",
    "screenshots": "node scripts/page-screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/saira-semi-condensed": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/pngjs": "6.0.5",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
