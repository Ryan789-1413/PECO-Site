{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/404.html",
        "http://localhost/products/index.html",
        "http://localhost/products/pumps/index.html",
        "http://localhost/products/chemistry/4000-series/index.html",
        "http://localhost/products/tanks/gemini-dual-containment-tanks/index.html"
      ],
      "numberOfRuns": 5
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          { "minScore": 0.95, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
