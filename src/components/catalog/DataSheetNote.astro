---
// Product data sheets and SDS are not published on the site; customers request them by
// phone or at orders@pecowater.com (Ryan, Oct 15-16, 2026). Chemistry is shown as series
// only, so chemistry notes also invite questions about any product (Ryan, Oct 16, 2026).
import { PHONE_DISPLAY, PHONE_TEL, ORDERS_EMAIL, ordersMailto } from '../../data/company';

interface Props {
  /** Product name, when shown on a product page. */
  product?: string;
  /** True next to the chemistry series (on /products/ and /products/chemistry/). */
  chemistry?: boolean;
}

const { product, chemistry = false } = Astro.props;
const subject = chemistry
  ? 'Product information: PECO chemistry'
  : product
    ? `Data sheet request: ${product}`
    : 'Data sheet request';
---

<aside class="note" aria-label="Product data sheets">
  {chemistry ? (
    <p>
      <strong>Need more information on our chemistry?</strong> Call{' '}
      <a href={PHONE_TEL}>{PHONE_DISPLAY}</a> or email{' '}
      <a href={ordersMailto(subject)}>{ORDERS_EMAIL}</a>. Product data sheets and safety data sheets
      (SDS) are available on request.
    </p>
  ) : (
    <p>
      <strong>Product data sheets and safety data sheets (SDS) are available on request.</strong>
      {product ? ` To request them for ${product}, call ` : ' Call '}
      <a href={PHONE_TEL}>{PHONE_DISPLAY}</a> or email{' '}
      <a href={ordersMailto(subject)}>{ORDERS_EMAIL}</a> and we will send them to you.
    </p>
  )}
  <a class="btn btn-ghost" href="/#contact">
    Talk with a specialist
  </a>
</aside>

<style>
  .note {
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--brand-tint);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
  }
  p {
    color: var(--ink);
    max-width: 70ch;
  }
  p a {
    white-space: nowrap;
  }
</style>
