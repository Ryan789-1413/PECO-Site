---
// Page header for catalog pages: breadcrumbs, eyebrow, h1 and lead on the blueprint grid.
import Breadcrumbs from './Breadcrumbs.astro';
import GapList from './GapList.astro';
import type { Crumb } from '../../lib/catalog';

interface Props {
  crumbs: Crumb[];
  eyebrow: string;
  title: string;
  lead: string;
  notes?: string[];
  gaps?: string[];
}

const { crumbs, eyebrow, title, lead, notes = [], gaps = [] } = Astro.props;
---

<section class="catalog-hero">
  <div class="wrap">
    <Breadcrumbs crumbs={crumbs} />
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="lead">{lead}</p>
      {notes.length > 0 && (
        <ul class="notes">
          {notes.map((n) => (
            <li>{n}</li>
          ))}
        </ul>
      )}
      <GapList gaps={gaps} />
    </div>
  </div>
</section>

<style>
  .catalog-hero {
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 32px 32px;
    border-bottom: 1px solid var(--line);
  }
  .wrap {
    padding-block: 32px 56px;
    display: grid;
    gap: 28px;
  }
  .copy {
    display: grid;
    gap: 16px;
    max-width: 760px;
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 700;
  }
  .notes {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .notes li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .notes li::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--brand);
    border-radius: 50%;
  }
  @media (max-width: 700px) {
    .wrap {
      padding-block: 24px 40px;
    }
  }
</style>
