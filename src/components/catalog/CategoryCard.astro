---
// Card for a catalog category or chemistry series. Equipment categories link to their pages.
// Chemistry series are shown only as plain cards (number, name, what it is for and a
// description), with no series pages (Ryan, Oct 16, 2026).
import { categoryHref, labelOf, type Category } from '../../lib/catalog';

interface Props {
  category: Category;
  count: number;
}

const { category, count } = Astro.props;
const { series, summary, intro } = category.data;
const countLabel = `${count} ${count === 1 ? 'product' : 'products'}`;
---

{series ? (
  <article class="card series">
    <span class="code">
      <span class="visually-hidden">Series </span>
      {series.code}
    </span>
    <h3>{series.products}</h3>
    {series.for && <p class="meta">For {series.for.toLowerCase()}</p>}
    <p class="summary">{intro}</p>
  </article>
) : (
  <a class="card" href={categoryHref(category.id)}>
    <h3>{labelOf(category)}</h3>
    <p class="meta">{countLabel}</p>
    <p class="summary">{summary}</p>
    <span class="go" aria-hidden="true">
      View &rarr;
    </span>
  </a>
)}

<style>
  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    height: 100%;
    padding: 22px 22px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  a.card:hover {
    border-color: var(--brand);
  }
  a.card:hover h3 {
    color: var(--brand);
  }
  .code {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
    color: var(--brand);
    letter-spacing: 0.01em;
  }
  h3 {
    font-size: var(--step-2);
    font-weight: 700;
  }
  .meta {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .summary {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .go {
    margin-top: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--brand);
  }
</style>
