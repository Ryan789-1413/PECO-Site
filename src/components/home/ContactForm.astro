---
/*
 * Site survey form, markup and styles from the prototype.
 * Not connected yet: Phase 4 adds a Cloudflare Pages Function at /api/site-survey/
 * (Turnstile, honeypot, email routing). method="post" keeps entries out of the URL;
 * until Phase 4 a submit on staging returns an error page.
 */
const systems = [
  'Cooling tower',
  'Boiler or steam',
  'Closed loop',
  'Heat transfer fluid or glycol',
  'Filtration, softener or pretreatment',
  'Feed pumps, controllers or probes',
  'Lab analysis through Ridgewater',
  'New construction or system cleaning',
  'Training or seasonal courses',
];
---

<form method="post" action="/api/site-survey/">
  <div class="field">
    <label for="f-name">Name</label>
    <input id="f-name" name="name" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="f-company">Company</label>
    <input id="f-company" name="company" autocomplete="organization" />
  </div>
  <div class="field">
    <label for="f-email">Email</label>
    <input id="f-email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="f-phone">Phone</label>
    <input id="f-phone" name="phone" type="tel" autocomplete="tel" />
  </div>
  <div class="field full">
    <label for="f-system">Primary system</label>
    <select id="f-system" name="system">
      {systems.map((s) => (
        <option>{s}</option>
      ))}
    </select>
  </div>
  <div class="field full">
    <label for="f-msg">How can we help?</label>
    <textarea id="f-msg" name="message"></textarea>
  </div>
  <button class="btn btn-primary" type="submit">
    Request a site survey
  </button>
</form>

<style>
  form {
    background: var(--deep-2);
    border: 1px solid var(--deep-line);
    border-radius: var(--radius);
    padding: 28px;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-content: start;
  }
  .field {
    display: grid;
    gap: 6px;
    min-width: 0;
  }
  .field.full {
    grid-column: 1 / -1;
  }
  label {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--deep-muted);
  }
  input,
  select,
  textarea {
    font: inherit;
    font-size: 0.9375rem;
    color: var(--deep-ink);
    background: var(--deep);
    border: 1px solid var(--deep-line);
    border-radius: 4px;
    padding: 11px 12px;
    width: 100%;
    color-scheme: dark;
  }
  textarea {
    min-height: 110px;
    resize: vertical;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: 2px solid var(--lab);
    outline-offset: 1px;
  }
  .btn {
    justify-self: start;
  }
  @media (max-width: 560px) {
    form {
      grid-template-columns: 1fr;
      padding: 20px;
    }
  }
</style>
