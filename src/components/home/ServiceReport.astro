---
// Illustrative digital service report card (labelled as an illustration in its footer).
const rows = [
  { label: 'Conductivity', limit: 'within control range', status: 'OK' },
  { label: 'pH', limit: 'within control range', status: 'OK' },
  { label: 'Inhibitor residual', limit: 'within control range', status: 'OK' },
  { label: 'Microbiological check', limit: 'within control range', status: 'OK' },
  { label: 'Corrective actions', limit: 'documented', status: 'LOGGED' },
];
---

<aside class="report" aria-label="Example digital service report">
  <div class="report-head">
    <b>Service Report</b>
    <span class="pill">Within limits</span>
  </div>
  <div class="report-meta">
    <div>
      <span>System</span>
      <strong>Cooling Tower 1</strong>
    </div>
    <div>
      <span>Visit</span>
      <strong>Bi-monthly</strong>
    </div>
    <div>
      <span>Status</span>
      <strong>Submitted onsite</strong>
    </div>
  </div>
  <div class="report-rows">
    {rows.map((r) => (
      <div class="rrow">
        <span>{r.label}</span>
        <span class="lim">{r.limit}</span>
        <span class="st">{r.status}</span>
      </div>
    ))}
  </div>
  <p class="report-foot">
    Illustration of the report layout. Your reports include your own systems, limits and results.
  </p>
</aside>

<style>
  .report {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: var(--shadow-report);
    overflow: hidden;
  }
  .report-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 16px 20px;
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }
  .report-head b {
    font-family: var(--f-display);
    font-size: 1.25rem;
  }
  .pill {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ok);
    border: 1px solid currentColor;
    border-radius: 999px;
    padding: 2px 10px;
  }
  .report-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .report-meta div {
    padding: 12px 20px;
    border-left: 1px solid var(--line);
    min-width: 0;
  }
  .report-meta div:first-child {
    border-left: 0;
  }
  .report-meta span {
    display: block;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .report-meta strong {
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .report-rows {
    padding: 6px 20px 14px;
    display: grid;
  }
  .rrow {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px dashed var(--line);
    font-size: 0.9375rem;
    align-items: center;
  }
  .rrow:last-child {
    border-bottom: 0;
  }
  .lim {
    font-family: var(--f-mono);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .st {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--ok);
  }
  .report-foot {
    padding: 12px 20px;
    background: var(--brand-tint);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (max-width: 520px) {
    .report-meta {
      grid-template-columns: 1fr;
    }
    .report-meta div {
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .report-meta div:first-child {
      border-top: 0;
    }
  }
</style>
