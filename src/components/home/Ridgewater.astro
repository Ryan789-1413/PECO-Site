---
import PhotoFigure from '../PhotoFigure.astro';
import AnalyteTable from './AnalyteTable.astro';
import labHplcIcp from '../../assets/photos/lab-hplc-icp.jpg';
import labIc from '../../assets/photos/lab-ic.jpg';

// No instrument models and no accreditations: PROJECT_CONTEXT §2 Ridgewater.
const instruments = [
  {
    full: 'High-performance liquid chromatography',
    abbr: 'HPLC',
    text: 'Separates and quantifies organic compounds, so we can measure the active ingredients that protect your system.',
    points: [
      'Product QC and active-ingredient verification',
      'Azole copper-corrosion inhibitors',
      'Formulation research and development',
    ],
  },
  {
    full: 'Inductively coupled plasma',
    abbr: 'ICP',
    text: 'Multi-element metals analysis down to trace levels, the clearest view of scaling and corrosion activity.',
    points: [
      'Calcium and magnesium hardness',
      'Iron, copper and zinc corrosion indicators',
      'Silica, molybdenum and total phosphorus',
    ],
  },
  {
    full: 'Ion chromatography',
    abbr: 'IC',
    text: 'Precise anion and cation profiling for makeup water characterization and cycles verification.',
    points: [
      'Chloride, sulfate and nitrate',
      'Orthophosphate and fluoride',
      'Nitrite levels in closed loops',
    ],
  },
];
---

<section class="section lab-band" id="ridgewater">
  <div class="wrap">
    <div class="lab-top">
      <div class="lab-name">
        <p class="eyebrow">Our in-house laboratory</p>
        <h2>
          Ridgewater Analytical<small>Full-capability water and chemistry lab</small>
        </h2>
        <p class="lead">
          Most treatment companies send samples out and wait. Our expanded analytical laboratory,
          Ridgewater Analytical, gives Power Engineering on-site support to identify, define and fix
          problems quickly. We can quantify what is in your water, confirm that our products
          perform, and act on the data without delay.
        </p>
      </div>
      <ul class="lab-facts">
        <li>
          <b>Leadership</b>
          <span>In-house PhD chemist</span>
        </li>
        <li>
          <b>Instruments</b>
          <span>
            HPLC, ICP and IC: a complete in-house analytical suite for every analysis we run
          </span>
        </li>
        <li>
          <b>Functions</b>
          <span>Quality control, research and development, advanced analytical testing</span>
        </li>
        <li>
          <b>Location</b>
          <span>Salt Lake City, alongside our chemical production</span>
        </li>
      </ul>
    </div>

    <div class="lab-photos">
      <PhotoFigure
        src={labHplcIcp}
        alt="ICP spectrometer with HPLC modules on an adjacent bench"
        sizes="(max-width: 760px) calc(100vw - 36px), 620px"
        caption="HPLC and ICP instrumentation"
      />
      <PhotoFigure
        src={labIc}
        alt="Ion chromatography system with eluent bottles and data workstation"
        sizes="(max-width: 760px) calc(100vw - 36px), 500px"
        caption="Ion chromatography"
      />
    </div>
    <div class="instruments">
      {instruments.map((inst) => (
        <article class="inst">
          <span class="full">{inst.full}</span>
          <span class="abbr">{inst.abbr}</span>
          <p>{inst.text}</p>
          <ul>
            {inst.points.map((p) => (
              <li>{p}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="panel">
      <div class="panel-copy">
        <p class="eyebrow">Inside a cooling water panel</p>
        <h3>Every analyte matched to the right instrument.</h3>
        <p>
          A typical cooling water analysis draws on all three instruments. Results are reported in
          the units your engineers and auditors expect, and they flow into the same digital record
          as your service reports.
        </p>
      </div>
      <AnalyteTable />
    </div>
  </div>
</section>

<style>
  .lab-band {
    background: var(--deep);
    color: var(--deep-ink);
  }
  .lab-band .eyebrow {
    color: var(--lab);
  }
  .lab-band .lead {
    color: var(--deep-muted);
  }
  .lab-top {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 56px;
    align-items: end;
    margin-bottom: 52px;
  }
  .lab-name {
    display: grid;
    gap: 16px;
  }
  h2 {
    font-size: clamp(2.6rem, 5.4vw, 4.2rem);
    font-weight: 700;
  }
  h2 small {
    display: block;
    font-size: 0.42em;
    font-weight: 600;
    color: var(--deep-muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin-top: 10px;
  }
  .lab-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--deep-line);
  }
  .lab-facts > :global(li) {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--deep-line);
    font-size: 0.9375rem;
  }
  .lab-facts :global(b) {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--deep-muted);
    padding-top: 3px;
  }

  .lab-photos {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    grid-auto-rows: 360px;
    gap: 20px;
    margin-bottom: 52px;
  }
  .lab-photos :global(.photo) {
    height: 100%;
    background: var(--deep-2);
  }
  @media (max-width: 760px) {
    .lab-photos {
      grid-template-columns: 1fr;
      grid-auto-rows: 260px;
    }
  }

  .instruments {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .inst {
    background: var(--deep-2);
    border: 1px solid var(--deep-line);
    border-radius: var(--radius);
    padding: 28px 26px;
    display: grid;
    gap: 12px;
    align-content: start;
    min-width: 0;
  }
  .abbr {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1;
    color: var(--deep-ink);
    letter-spacing: 0.01em;
  }
  .full {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lab);
  }
  .inst p {
    color: var(--deep-muted);
    font-size: 0.9375rem;
  }
  .inst ul {
    list-style: none;
    margin: 6px 0 0;
    padding: 14px 0 0;
    border-top: 1px solid var(--deep-line);
    display: grid;
    gap: 6px;
    font-size: 0.9375rem;
  }
  .inst li {
    padding-left: 18px;
    position: relative;
  }
  .inst li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1.5px;
    background: var(--lab);
  }

  .panel {
    margin-top: 52px;
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 48px;
    align-items: start;
  }
  .panel-copy {
    display: grid;
    gap: 14px;
  }
  .panel-copy h3 {
    font-size: var(--step-3);
    font-weight: 700;
  }
  .panel-copy p:not(.eyebrow) {
    color: var(--deep-muted);
  }
  @media (max-width: 960px) {
    .lab-top,
    .panel {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .instruments {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 480px) {
    .lab-facts > :global(li) {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
