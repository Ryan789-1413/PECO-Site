---
import PhotoFigure from '../PhotoFigure.astro';
import pumpMeter from '../../assets/photos/pump-meter.jpg';
import loopPiping from '../../assets/photos/loop-piping.jpg';
import pumpsCondenser from '../../assets/photos/pumps-condenser.jpg';

const cardSizes = '(max-width: 600px) calc(100vw - 36px), (max-width: 960px) 50vw, 380px';

const groups: { title: string; items: string[] }[] = [
  {
    title: 'Feed and dosing',
    items: [
      'LMI and Walchem chemical metering pumps',
      'Chemical feed stations and panels',
      'Pot feeders for closed loops',
      'High-pressure transfer pumps, permanent or portable',
      'PECO chemical tanks and containment',
    ],
  },
  {
    title: 'Control and monitoring',
    items: [
      'Walchem and LMI cooling tower and boiler controllers',
      'Conductivity, pH, ORP and fluorescence sensors',
      'Mass balance control with web-based reporting and trending',
      'Belimo and Bi-torq motorized valves',
      'Corrosion coupon racks and hand-held test kits',
    ],
  },
  {
    title: 'Glycol and closed loops',
    items: [
      'GC7 and GC8 glycol feeders',
      'Glycol recovery systems',
      'Heat transfer fluids and freeze protection',
      'Freeze point and inhibitor testing',
      'Loop flushing, cleaning and passivation',
    ],
  },
  {
    title: 'Filtration and pretreatment',
    items: [
      'Side-stream filtration for cooling towers',
      'Cartridge and bag filter housings',
      'Closed loop filtration',
      'Water softeners and dealkalizers',
      'Reverse osmosis and RO re-pressure pumps',
      'Filter elements, media and spare parts',
    ],
  },
];

const brands = ['Walchem', 'LMI', 'Belimo', 'Bi-torq', 'PECO'];
---

<section class="section" id="equipment">
  <div class="wrap">
    <div class="section-head">
      <p class="eyebrow">Equipment and filtration</p>
      <h2>Everything it takes to protect your equipment chemically.</h2>
      <p class="lead">
        Chemistry only works when it is fed accurately, measured continuously and kept clean. We
        supply, install and service the full set of hardware behind every program, from the pump on
        the tank to the probe in the line.
      </p>
    </div>

    <div class="equip-top">
      <article class="equip-card">
        <PhotoFigure
          src={pumpMeter}
          alt="Electronic chemical metering pump with digital display"
          sizes={cardSizes}
          caption="Chemical feed"
        />
        <div class="body">
          <h3>Chemical feed pumps</h3>
          <p>
            LMI Roytronic and Walchem EHE and EZ series metering pumps sized to your dosage, plus
            feed stations, transfer pumps and tubing set up for accurate, repeatable feed.
          </p>
        </div>
      </article>
      <article class="equip-card">
        <PhotoFigure
          src={loopPiping}
          alt="Insulated hydronic loop piping with gauges, pumps and valve actuators"
          sizes={cardSizes}
          caption="Controls and closed loops"
        />
        <div class="body">
          <h3>Controllers, probes and glycol feed</h3>
          <p>
            Walchem and LMI controllers that automate blowdown and feed from conductivity, pH, ORP
            or fluorescence probes, and GC7 and GC8 glycol feeders that hold loop pressure and
            freeze protection.
          </p>
        </div>
      </article>
      <article class="equip-card">
        <PhotoFigure
          src={pumpsCondenser}
          alt="Condenser water pumps and piping in a commercial mechanical room"
          sizes={cardSizes}
          caption="Condenser water"
        />
        <div class="body">
          <h3>Filtration</h3>
          <p>
            Side-stream and full-flow filtration that removes the dirt, debris and suspended solids
            that drive fouling, under-deposit corrosion and biological growth.
          </p>
        </div>
      </article>
    </div>

    <div class="equip-list">
      {groups.map((group) => (
        <div class="equip-group">
          <h4>{group.title}</h4>
          <ul>
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="equip-note">
      <p>
        <strong>Sized, installed and serviced by our own team.</strong> We match every pump,
        controller and filter to your system, install it, calibrate it and keep replacement parts on
        the shelf in Salt Lake City and Idaho Falls.
      </p>
      <a class="btn btn-ghost" href="#contact">
        Ask about equipment
      </a>
    </div>

    <div class="brands">
      <span>Brands we install and service</span>
      <div class="brand-row">
        {brands.map((b) => (
          <b>{b}</b>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .equip-top {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }
  .equip-card {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr;
    min-width: 0;
  }
  .equip-card :global(.photo) {
    border-radius: 0;
    aspect-ratio: 4 / 3;
    max-width: 100%;
  }
  .body {
    padding: 22px 22px 24px;
    display: grid;
    gap: 10px;
    align-content: start;
  }
  h3 {
    font-size: var(--step-2);
    font-weight: 700;
  }
  .body > :global(p) {
    color: var(--muted);
    font-size: 0.9375rem;
  }
  .equip-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .equip-group {
    padding: 22px 20px 4px 0;
    display: grid;
    gap: 10px;
    align-content: start;
    min-width: 0;
  }
  h4 {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brand);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 7px;
    font-size: 0.9375rem;
  }
  ul > :global(li) {
    padding-left: 18px;
    position: relative;
  }
  ul > :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1.5px;
    background: var(--brand);
  }
  .equip-note {
    margin-top: 28px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--brand-tint);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
    align-items: center;
    justify-content: space-between;
  }
  .equip-note p {
    color: var(--ink);
    max-width: 70ch;
  }
  @media (max-width: 960px) {
    .equip-top {
      grid-template-columns: 1fr 1fr;
    }
    .equip-list {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .equip-top,
    .equip-list {
      grid-template-columns: 1fr;
    }
  }

  .brands {
    margin-top: 28px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 12px 24px;
    align-items: center;
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }
  .brands > span {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .brand-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .brand-row b {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 1.125rem;
    letter-spacing: 0.02em;
    padding: 6px 14px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: var(--surface);
    color: var(--ink);
  }
  @media (max-width: 560px) {
    .brands {
      grid-template-columns: 1fr;
    }
  }
</style>
