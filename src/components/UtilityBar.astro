---
// Navy utility bar above the header. Copy matches prototype/index.html.
---

<div class="utility">
  <div class="wrap">
    <span class="anniv"><b>Celebrating 80 years</b> &middot; 1946&ndash;2026</span>
    <span>AWT member &middot; Associated Labs member &middot; <strong>801.532.6972</strong></span>
  </div>
</div>

<style>
  .utility {
    background: var(--deep);
    color: var(--deep-muted);
    font-size: var(--step--1);
  }
  .utility .wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
    justify-content: space-between;
    padding-block: 8px;
  }
  .utility strong {
    color: var(--deep-ink);
    font-weight: 500;
  }
  .anniv {
    font-family: var(--f-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .anniv b {
    color: var(--deep-ink);
    font-weight: 500;
  }
</style>
